# =============================================================================
# trivia-torah — variáveis de ambiente
# Crie o `.env` com `pnpm secrets:init`: ele copia este arquivo e gera os segredos.
# NUNCA faça commit do `.env`. Nenhum segredo daqui vai para o app mobile.
# =============================================================================

# --- Banco de dados (api + pipeline) -----------------------------------------
# Bate com o docker-compose.yml (que só aceita conexões deste computador).
# Em produção, use a URL do seu Postgres gerenciado, com TLS (?sslmode=require) e um
# usuário sem permissão de alterar tabelas (veja docs/SECURITY.md).
DATABASE_URL="postgresql://trivia:trivia@localhost:5432/trivia_torah?schema=public"

# --- API (apps/api) ------------------------------------------------------------
PORT=3000
# Interface onde a API escuta. Vazio = todas (o celular na mesma rede precisa disso em
# desenvolvimento). Em produção, atrás de um proxy na mesma máquina: HOST="127.0.0.1".
HOST=""
# Segredos dos tokens de login. A API NÃO SOBE com estes valores de exemplo:
# rode `pnpm secrets:init` (ou gere cada um com
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_REFRESH_SECRET="troque-por-outro-segredo-longo-e-aleatorio"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Origens permitidas no CORS (separadas por vírgula). O app nativo não usa CORS;
# isto vale para a versão web do app (Expo Web). Em produção, só origens https://.
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"
# Fuso usado para zerar o ranking semanal (segunda-feira, 00:00).
RANKING_TIMEZONE="America/Sao_Paulo"
# Bots na roleta: no modo aleatório, sem ninguém na fila por 8 segundos, um bot do nível
# do jogador entra no lugar do adversário (com o selo BOT; não entra no ranking).
BOTS_ENABLED="true"
# Idiomas (Fase 8): textos que o Sefaria não tem em português ou inglês com licença
# aberta são traduzidos do original uma vez, guardados e reaproveitados por todos.
# anthropic (precisa de ANTHROPIC_API_KEY, abaixo) | off | fake (só desenvolvimento).
# Vazio = anthropic se houver chave, senão off (o jogo só mostra o que já existe no idioma).
TRANSLATION_PROVIDER=""
TRANSLATION_MODEL="claude-sonnet-5-5"
TRANSLATION_CONCURRENCY="4"
# Tradução aos poucos, em segundo plano, do que ainda falta (Torá primeiro).
TRANSLATION_WARMER="true"
# Versão web do jogo servida pela própria API, no mesmo endereço (a API fica em /api).
# "pnpm lan" já define isto; deixe vazio para a API servir só a API.
WEB_DIR=""
# Economia (Fase 9, docs/ECONOMY.md). Anúncios: admob | trust-client | demo | off.
# Compras: live | demo | off. Vazios = demonstração em desenvolvimento; em produção só os
# de verdade (a API não sobe com demo nem trust-client fora de development/test).
ADS_MODE=""
STORE_MODE=""
# App Store: bundle id, id numérico do app (App Store Connect) e a pasta com AppleRootCA-G3.cer.
APPLE_BUNDLE_ID=""
APPLE_APP_ID=""
APPLE_ROOT_CERTS_DIR="certs/apple"
# Google Play: nome do pacote e o JSON de uma conta de serviço com acesso à API do Play.
GOOGLE_PLAY_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=""
# Login social (Fase 10, docs/AUTH.md). Sem as variáveis de um provedor, o botão dele não aparece.
# Google: ids de cliente OAuth do app (web, iOS, Android), separados por vírgula.
GOOGLE_CLIENT_IDS=""
# Apple: quem recebe o token (vazio = APPLE_BUNDLE_ID); acrescente o Services ID se houver login da Apple na web.
APPLE_SIGNIN_CLIENT_IDS=""
# Facebook: id e segredo do app no Meta for Developers (os dois juntos).
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# development | test | production. Qualquer valor diferente de development/test (ou a
# variável ausente) liga as regras de produção: CORS só https, HSTS, avisos.
NODE_ENV="development"
# Quantos proxies reversos (nginx, Render, Fly, Cloudflare…) ficam na frente da API.
# Define o IP real do cliente para o limite de requisições. Sem proxy: false.
# Com proxy, só ele pode alcançar a porta da API (HOST=127.0.0.1 ou firewall): quem
# falar direto com a API poderia forjar o IP no X-Forwarded-For.
TRUST_PROXY="false"
# A revisão humana (/admin) usa contas pessoais de revisor: crie com
#   pnpm reviewers create --email voce@exemplo.com --name "Seu nome"

# --- Motor de IA (pipeline) ----------------------------------------------------
# anthropic | openai
LLM_PROVIDER="anthropic"
# Preencha só a chave do provedor que for usar.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Modelo que gera as perguntas e modelo que as verifica às cegas.
# Exemplos Anthropic: claude-sonnet-5-5 (gerador), claude-haiku-5-5 (verificador).
LLM_GENERATOR_MODEL="claude-sonnet-5-5"
LLM_VERIFIER_MODEL="claude-haiku-5-5"
# Opcional: provedor diferente só para o verificador (anthropic | openai). Vazio = mesmo do gerador.
LLM_VERIFIER_PROVIDER=""
# Usar a Batch API do provedor (Anthropic: ~50% mais barata, resultado em até 24 h).
# "generate --sync" ignora isto e responde na hora; "generate --batch" força o lote.
LLM_USE_BATCH_API="true"
# Chamadas simultâneas no modo síncrono.
LLM_MAX_CONCURRENCY=4
# Teto de tokens da resposta do gerador.
LLM_MAX_OUTPUT_TOKENS=4000

# --- Fonte de dados Sefaria (pipeline) ------------------------------------------
# Pasta local onde o comando "pipeline download" espelha o Sefaria-Export
# (books.json, json/..., schemas/...). Caminho relativo à raiz do projeto.
SEFARIA_EXPORT_PATH="./data/sefaria-export"
# Origem dos dados: bucket público do Sefaria e o índice books.json no GitHub.
SEFARIA_EXPORT_BASE_URL="https://storage.googleapis.com/sefaria-export"
SEFARIA_BOOKS_INDEX_URL="https://raw.githubusercontent.com/Sefaria/Sefaria-Export/master/books.json"
# Idiomas de texto-fonte entregues ao LLM (he = hebraico/aramaico, en = inglês, pt = português).
SOURCE_LANGUAGES="he,en,pt"
# Licenças aceitas. Versões com outras licenças (CC-BY-NC, "unknown"…) são ignoradas.
ALLOWED_LICENSES="Public Domain,CC0,CC-BY,CC-BY-SA"
# Versões liberadas pelo detentor dos direitos mesmo sem licença aberta declarada no Sefaria,
# pelo título exato da versão, separadas por ";". Ex.: "Minha Tradução [pt];Outra Versão [pt]"
SEFARIA_AUTHORIZED_VERSIONS=""

# --- Geração de conteúdo ---------------------------------------------------------
QUESTION_LOCALE="pt-BR"
# Grafia dos nomes nas perguntas: portuguese (Abraão, Moisés) | transliterated (Avraham, Moshé)
QUESTION_NAME_STYLE="portuguese"
# Perguntas pedidas por passagem (1 a 3).
QUESTIONS_PER_PASSAGE=2
# Passagens por execução de "generate" quando --limit não é informado.
GENERATION_BATCH_SIZE=50
# true = toda pergunta nova entra como "pending_review" e só vai ao jogo após aprovação humana.
REQUIRE_HUMAN_REVIEW="true"
# Onde o pipeline grava relatórios de revisão.
PIPELINE_OUT_DIR="./pipeline/out"

# --- Testes ----------------------------------------------------------------------
# Banco SEPARADO para os testes de integração do pipeline e da API (eles apagam as tabelas!).
# Deixe vazio para pular esse teste.
TEST_DATABASE_URL=""

# --- App mobile ------------------------------------------------------------------
# O Expo NÃO lê este arquivo da raiz. Em desenvolvimento o app descobre sozinho a API
# (o mesmo computador que serve o Expo, porta 3000). Para fixar outro endereço, crie
# apps/mobile/.env com a linha abaixo. Tudo com prefixo EXPO_PUBLIC_ vai embutido no
# app instalado: só URLs públicas aqui.
# EXPO_PUBLIC_API_URL="http://192.168.0.10:3000"
