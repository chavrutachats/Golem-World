{
  "name": "@trivia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do jogo (NestJS 12 + Prisma + PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reviewers": "tsx src/cli/reviewers.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@trivia/db": "workspace:*",
    "@trivia/shared": "workspace:*",
    "dotenv": "^18.0.9",
    "google-auth-library": "^11.3.2",
    "helmet": "8.3.0",
    "jose": "^6.2.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
