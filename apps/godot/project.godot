; Trivia Torá, cliente em Godot 4 (Fase 14).
config_version=5

[application]

config/name="Trivia Torá"
config/description="Quiz de textos judaicos com o sevivon"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0706, 0.0941, 0.2392, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Api="*res://scripts/autoload/api.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Ui="*res://scripts/autoload/ui.gd"
Economy="*res://scripts/autoload/economy.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

rendering/text_driver="ICU / HarfBuzz / Graphite (Built-in)"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0706, 0.0941, 0.2392, 1)

[trivia]

api_url="http://127.0.0.1:3000"
